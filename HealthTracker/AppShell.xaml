<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HealthTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:HealthTracker"
    Title="HealthTracker">

    <!-- Calliope - TabBar = the bottom tab strip. Each ShellContent is one tab,
        in order: Home, Goals, Add Food, Nutrition, Fitness. Title-only for now;
        real icons are a polish step later. Each tab owns its route, so GoToAsync
        with a tab's //RouteName switches to that tab. -->
    <TabBar>
        <ShellContent Title="Home"
                      ContentTemplate="{DataTemplate local:MainPage}"
                      Route="MainPage" />
        <ShellContent Title="Goals"
                      ContentTemplate="{DataTemplate local:GoalsPage}"
                      Route="GoalsPage" />
        <ShellContent Title="Add Food"
                      ContentTemplate="{DataTemplate local:AddFoodPage}"
                      Route="AddFoodPage" />
        <ShellContent Title="Nutrition"
                      ContentTemplate="{DataTemplate local:NutritionPage}"
                      Route="NutritionPage" />
        <ShellContent Title="Fitness"
                      ContentTemplate="{DataTemplate local:FitnessPage}"
                      Route="FitnessPage" />
    </TabBar>

</Shell>
