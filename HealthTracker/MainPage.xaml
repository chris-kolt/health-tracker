<?xml version="1.0" encoding="utf-8" ?>
<!-- Calliope - Every XAML page opens with this header. The xmlns lines are namespace
     declarations: the first means "the MAUI controls" (Label, Button, Border...), the
     x: one means "the XAML language itself" (x:Name, x:Class). Copy them verbatim onto
     every new page; you never edit them. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthTracker.MainPage">
    <!-- Calliope - x:Class is the handshake: "this layout belongs to the MainPage class
         in MainPage.xaml.cs". The two files compile into ONE class. -->

    <!-- Calliope - ScrollView: if the content is taller than the screen, the user can
         scroll. On a phone, wrap nearly every page in one. -->
    <ScrollView>
        <!-- Calliope - VerticalStackLayout stacks children top-to-bottom, like Unity's
             Vertical Layout Group. Padding = space inside the container's edges,
             Spacing = gaps between the children. -->
        <VerticalStackLayout
            Padding="20"
            Spacing="16">

            <!-- Header -->
            <Label
                Text="Today"
                Style="{StaticResource Headline}" />
            <!-- Calliope - Style pulls a shared definition from App.xaml (the theme).
                 Change it there once and every page updates. Never hand-style each label. -->
            <Label
                x:Name="DateLabel"
                Style="{StaticResource SubHeadline}" />
            <!-- Calliope - x:Name exposes this label to the code-behind as a variable
                 called DateLabel. MainPage.xaml.cs sets its text to today's date below. -->

            <!-- Calories card -->
            <!-- Calliope - Border is MAUI's "card" container. StrokeShape rounds the
                 corners. BackgroundColor uses AppThemeBinding so the card looks right
                 in both light and dark mode, following your phone's theme. -->
            <Border
                StrokeShape="RoundRectangle 12"
                Padding="16"
                BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Calories" FontAttributes="Bold" />
                    <Label x:Name="CaloriesLabel" Text="…" FontSize="28" FontAttributes="Bold" />
                    <ProgressBar x:Name="CaloriesBar" Progress="0" />
                    <Label x:Name="RemainingLabel" Text="…" FontSize="13" TextColor="Gray" />

                </VerticalStackLayout>
            </Border>

            <!-- Meals -->
            <Label Text="Meals" Style="{StaticResource SubHeadline}" />
            <VerticalStackLayout Spacing="10">
                <!-- Calliope - Each meal is its own Border card, same pattern as the
                     calories card. To add a meal, copy a whole Border block and paste
                     it below — safest way to experiment. -->
                <Border
                    StrokeShape="RoundRectangle 12"
                    Padding="14"
                    BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
                    <VerticalStackLayout>
                        <Label Text="Oatmeal with berries" FontAttributes="Bold" />
                        <Label Text="320 cal · 12g protein" FontSize="13" TextColor="Gray" />
                    </VerticalStackLayout>
                </Border>
                <Border
                    StrokeShape="RoundRectangle 12"
                    Padding="14"
                    BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
                    <VerticalStackLayout>
                        <Label Text="Chicken salad" FontAttributes="Bold" />
                        <Label Text="450 cal · 35g protein" FontSize="13" TextColor="Gray" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Workout -->
            <Label Text="Workout" Style="{StaticResource SubHeadline}" />
            <Border
                StrokeShape="RoundRectangle 12"
                Padding="14"
                BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
                <!-- Calliope - HorizontalStackLayout is the sideways version: children
                     left-to-right. Used here to put the checkbox next to its label. -->
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <CheckBox
                        x:Name="WorkoutCheckBox"
                        CheckedChanged="OnWorkoutChecked"
                        VerticalOptions="Center" />
                    <!-- Calliope - CheckedChanged="OnWorkoutChecked" wires the toggle event
                         to a method in MainPage.xaml.cs — the same idea as the sample's
                         Clicked="OnCounterClicked". The handler flips the label text. -->
                    <Label
                        x:Name="WorkoutLabel"
                        Text="Daily routine — done!"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
