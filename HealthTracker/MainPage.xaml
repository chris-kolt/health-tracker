<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthTracker.MainPage"
             Title="Home">

    <!-- Calliope - ScrollView: the cards must fit small phones, so the page scrolls. -->
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Calliope - Date chip: a Border draws the rounded box, the Label holds
                 the date. HorizontalOptions="Center" shrinks the box to the text. -->
            <Border StrokeShape="RoundRectangle 10"
                    Padding="14,8"
                    HorizontalOptions="Center">
                <Label x:Name="DateLabel" FontSize="16" />
            </Border>

            <!-- Calliope - Calories card. Border = the card outline; inside, a header
                 row (title + expand button, the Grid pattern you already know) and
                 the big numbers. -->
            <Border StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                        <Label Text="Calories" FontSize="20"
                               TextDecorations="Underline"
                               VerticalOptions="Center" />
                        <Button Text="›" Grid.Column="1"
                                Clicked="OnShowDetailsClicked"
                                VerticalOptions="Center" />
                    </Grid>
                    <Label x:Name="CaloriesLabel" FontSize="34"
                           HorizontalOptions="Center" />
                    <Label x:Name="RemainingLabel" FontSize="14" TextColor="Gray"
                           HorizontalOptions="Center" />
                    <ProgressBar x:Name="CaloriesBar" />
                </VerticalStackLayout>
            </Border>

            <!-- Calliope - Macros card. Four equal columns; each column is eaten/goal,
                 a progress bar, and the name. The bars are stand-ins — your hand-drawn
                 rings replace them in the next step. -->
            <Border StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                        <Label Text="Macros" FontSize="20"
                               TextDecorations="Underline"
                               VerticalOptions="Center" />
                        <Button Text="›" Grid.Column="1"
                                Clicked="OnShowDetailsClicked"
                                VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="4">
                            <Label x:Name="ProteinLabel" FontSize="12"
                                   HorizontalOptions="Center" />
                            <GraphicsView x:Name="ProteinRing" HeightRequest="64" WidthRequest="64" HorizontalOptions="Center" />
                            <Label Text="Protein" FontSize="12"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label x:Name="CarbsLabel" FontSize="12"
                                   HorizontalOptions="Center" />
                            <GraphicsView x:Name="CarbsRing" HeightRequest="64" WidthRequest="64" HorizontalOptions="Center" />
                            <Label Text="Carbs" FontSize="12"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="4">
                            <Label x:Name="FatLabel" FontSize="12"
                                   HorizontalOptions="Center" />
                            <GraphicsView x:Name="FatRing" HeightRequest="64" WidthRequest="64" HorizontalOptions="Center" />
                            <Label Text="Fat" FontSize="12"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="3" Spacing="4">
                            <Label x:Name="FiberLabel" FontSize="12"
                                   HorizontalOptions="Center" />
                            <GraphicsView x:Name="FiberRing" HeightRequest="64" WidthRequest="64" HorizontalOptions="Center" />
                            <Label Text="Fiber" FontSize="12"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
